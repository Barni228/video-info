import { Palette } from "std-widgets.slint";

export enum ThemeMode { System, Light, Dark }

// A hand-rolled Catppuccin Mocha (dark) / Latte (light) palette, used
// instead of the default style's neutral Palette colors.
//
// Globals are per top-level component: AppWindow and SettingsWindow each
// get their own copy of this one, so Rust has to set `mode` and
// `system-is-dark` on both (see apply_theme in src/ui.rs).
export global Theme {
    // Set by Rust: the user's preference from the Settings window, plus --
    // when that preference is System -- the OS's current color scheme,
    // kept up to date from winit's WindowEvent::ThemeChanged.
    in-out property <ThemeMode> mode: ThemeMode.System;
    in-out property <bool> system-is-dark: false;

    out property <bool> is-dark: mode == ThemeMode.Dark
        ? true
        : mode == ThemeMode.Light ? false : system-is-dark;

    out property <color> surface-background: is-dark ? #11111b : #eff1f5;
    out property <color> panel-background: is-dark ? #181825 : #e6e9ef;
    out property <color> hover-background: is-dark ? #1e2030 : #ccd0da;
    out property <color> raw-view-background: is-dark ? #313244 : #ccd0da;
    out property <color> border-color: is-dark ? #45475a : #bcc0cc;
    out property <color> text-color: is-dark ? #cdd6f4 : #4c4f69;
    out property <color> secondary-text-color: is-dark ? #a6adc8 : #6c6f85;
    out property <color> accent-color: is-dark ? #89b4fa : #1e66f5;
    out property <color> error-color: is-dark ? #f38ba8 : #d20f39;
}

// The std-widgets (Button, ComboBox, Slider, Switch, ScrollView...) don't
// read `Theme` -- they draw from the current style's own Palette, which
// follows the OS color scheme unless something overrides it. Without this
// they stay dark on a dark system even when the user picks Light.
//
// Each Window places one of these directly in its body (not inside a
// layout -- it is zero-sized) to keep that Palette in step with `Theme`.
export component ThemeBridge {
    width: 0px;
    height: 0px;

    property <bool> dark: Theme.is-dark;

    init => { root.apply(); }
    changed dark => { root.apply(); }

    function apply() {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
}
