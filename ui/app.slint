import {
    Button,
    ScrollView,
    Switch,
    VerticalBox,
    HorizontalBox,
} from "std-widgets.slint";

export struct InfoRow {
    label: string,
    value: string,
}

export component AppWindow inherits Window {
    title: "Video Info";
    preferred-width: 640px;
    preferred-height: 580px;
    min-width: 480px;
    min-height: 420px;
    background: #11111b;
    default-font-size: 16px * root.zoom;

    in-out property <bool> has-file: false;
    in-out property <bool> is-drag-hover: false;
    in-out property <string> file-name: "";
    in-out property <string> status-text: "";
    in-out property <bool> is-error: false;
    in-out property <[InfoRow]> info-rows: [];
    // Same data as info-rows, flattened to "label: value" lines, for the
    // raw-text view (a single selectable block, easier to select-all/copy
    // from than the per-row layout).
    in-out property <string> raw-info-text: "";
    in-out property <bool> show-raw-view: false;

    // Zoom level applied to font sizes and layout metrics, like a browser's
    // page zoom. 1.0 = 100%. Controlled by the View menu / Cmd +/-/0.
    in-out property <float> zoom: 1.0;

    callback browse-clicked();
    callback copy-all-clicked();

    MenuBar {
        Menu {
            title: "View";

            MenuItem {
                title: "Zoom In";
                // Bound to the unshifted "=" key (not "+"/Shift+=) so the
                // plain Cmd+= press most people reflexively use also works.
                shortcut: @keys(Control + Equals);
                activated => { root.zoom = min(root.zoom + 0.1, 3.0); }
            }

            MenuItem {
                title: "Zoom Out";
                shortcut: @keys(Control + HyphenMinus);
                activated => { root.zoom = max(root.zoom - 0.1, 0.5); }
            }

            MenuItem {
                title: "Reset Zoom";
                shortcut: @keys(Control + "0");
                activated => { root.zoom = 1.0; }
            }
        }
    }

    FocusScope {
        key-pressed(event) => {
            if (event.text == "r" || event.text == "R") {
                root.show-raw-view = !root.show-raw-view;
                return accept;
            }
            return reject;
        }

        init => { self.focus(); }

        ScrollView {
            VerticalBox {
                padding: 18px * root.zoom;
                spacing: 12px * root.zoom;
                alignment: start;

                Text {
                    text: "Video Info";
                    font-size: 22px * root.zoom;
                    font-weight: 700;
                    color: #cdd6f4;
                }

                Rectangle {
                    height: (has-file ? 84px : 170px) * root.zoom;
                    border-radius: 12px;
                    border-width: 2px;
                    border-color: is-drag-hover ? #89b4fa : #45475a;
                    background: is-drag-hover ? #1e2030 : #181825;

                    VerticalBox {
                        alignment: center;
                        spacing: 4px * root.zoom;

                        Text {
                            text: has-file ? file-name : "Drag & drop a file here";
                            color: #cdd6f4;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        Text {
                            visible: !has-file;
                            text: "or use the button below";
                            color: #a6adc8;
                            font-size: 13px * root.zoom;
                            horizontal-alignment: center;
                        }
                    }
                }

                Button {
                    text: "Browse for file...";
                    clicked => { root.browse-clicked(); }
                }

                TextInput {
                    visible: status-text != "";
                    text: status-text;
                    color: is-error ? #f38ba8 : #a6adc8;
                    font-size: 14px * root.zoom;
                    wrap: word-wrap;
                    read-only: true;
                    single-line: false;
                }

                HorizontalBox {
                    visible: info-rows.length > 0;
                    padding: 0px;
                    alignment: end;

                    Switch {
                        text: "Raw Text View";
                        checked <=> root.show-raw-view;
                    }

                    Button {
                        text: "Copy All";
                        clicked => { root.copy-all-clicked(); }
                    }
                }

                if show-raw-view && info-rows.length > 0: Rectangle {
                    background: #313244;
                    border-radius: 8px;

                    VerticalBox {
                        padding: 12px * root.zoom;

                        TextInput {
                            text: raw-info-text;
                            font-family: "Courier New";
                            color: #cdd6f4;
                            wrap: word-wrap;
                            read-only: true;
                            single-line: false;
                        }
                    }
                }

                if !show-raw-view: VerticalBox {
                    padding: 0px;
                    spacing: 6px * root.zoom;

                    for row in info-rows: Rectangle {
                        background: #181825;
                        border-radius: 6px;

                        HorizontalBox {
                            padding: 6px * root.zoom;
                            spacing: 8px * root.zoom;

                            TextInput {
                                text: row.label;
                                font-weight: 600;
                                color: #89b4fa;
                                width: 150px * root.zoom;
                                wrap: word-wrap;
                                read-only: true;
                                single-line: false;
                            }

                            TextInput {
                                text: row.value;
                                color: #cdd6f4;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                                read-only: true;
                                single-line: false;
                            }
                        }
                    }
                }
            }
        }
    }
}
