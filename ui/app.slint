import {
    Button,
    ComboBox,
    ScrollView,
    Slider,
    Switch,
    VerticalBox,
    HorizontalBox,
} from "std-widgets.slint";

export struct InfoRow {
    label: string,
    value: string,
}

export enum ThemeMode { System, Light, Dark }

// Define my own Catppuccin Mocha (dark) / Latte (light) theme, instead of
// using the default style's neutral Palette colors.
export global Theme {
    // Set by Rust: the user's theme preference (from Settings), and, when
    // mode is System, the OS's current color scheme -- kept in sync via
    // winit's WindowEvent::ThemeChanged.
    in-out property <ThemeMode> mode: ThemeMode.System;
    in-out property <bool> system-is-dark: false;
    out property <bool> is-dark: mode == ThemeMode.Dark ? true : mode == ThemeMode.Light ? false : system-is-dark;
    out property <color> surface-background: is-dark ? #11111b : #eff1f5;
    out property <color> panel-background: is-dark ? #181825 : #e6e9ef;
    out property <color> hover-background: is-dark ? #1e2030 : #ccd0da;
    out property <color> raw-view-background: is-dark ? #313244 : #ccd0da;
    out property <color> border-color: is-dark ? #45475a : #bcc0cc;
    out property <color> text-color: is-dark ? #cdd6f4 : #4c4f69;
    out property <color> secondary-text-color: is-dark ? #a6adc8 : #6c6f85;
    out property <color> accent-color: is-dark ? #89b4fa : #1e66f5;
    out property <color> error-color: is-dark ? #f38ba8 : #d20f39;
}

export component AppWindow inherits Window {
    title: "Video Info";
    preferred-width: 640px;
    preferred-height: 580px;
    min-width: 480px;
    min-height: 420px;
    default-font-size: root.base-font-size * 1px * root.zoom;
    background: Theme.surface-background;
    always-on-top: root.keep-on-top;

    in-out property <bool> has-file: false;
    in-out property <bool> is-drag-hover: false;
    in-out property <string> file-name: "";
    in-out property <string> status-text: "";
    in-out property <bool> is-error: false;
    in-out property <[InfoRow]> info-rows: [];
    // Same data as info-rows, flattened to "label: value" lines, for the
    // raw-text view (a single selectable block, easier to select-all/copy
    // from than the per-row layout).
    in-out property <string> raw-info-text: "";
    in-out property <bool> show-raw-view: false;

    // Zoom level applied to font sizes and layout metrics, like a browser's
    // page zoom. 1.0 = 100%. Controlled by the View menu / Cmd +/-/0.
    in-out property <float> zoom: 1.0;

    // Persisted settings (loaded/saved by Rust), applied here as the base
    // that zoom multiplies on top of / the actual window behavior.
    in-out property <float> base-font-size: 16.0;
    in-out property <bool> keep-on-top: false;

    callback browse-clicked();
    callback copy-all-clicked();
    callback settings-clicked();

    MenuBar {
        Menu {
            title: "View";

            MenuItem {
                title: "Settings…";
                shortcut: @keys(Control + Comma);
                activated => { root.settings-clicked(); }
            }

            MenuSeparator {}

            MenuItem {
                title: "Zoom In";
                // Bound to the unshifted "=" key (not "+"/Shift+=) so the
                // plain Cmd+= press most people reflexively use also works.
                shortcut: @keys(Control + Equals);
                activated => { root.zoom = min(root.zoom + 0.1, 3.0); }
            }

            MenuItem {
                title: "Zoom Out";
                shortcut: @keys(Control + HyphenMinus);
                activated => { root.zoom = max(root.zoom - 0.1, 0.5); }
            }

            MenuItem {
                title: "Reset Zoom";
                shortcut: @keys(Control + "0");
                activated => { root.zoom = 1.0; }
            }
        }
    }

    FocusScope {
        key-pressed(event) => {
            if (event.text == "r" || event.text == "R") {
                root.show-raw-view = !root.show-raw-view;
                return accept;
            }
            return reject;
        }

        init => { self.focus(); }

        ScrollView {
            VerticalBox {
                padding: 18px * root.zoom;
                spacing: 12px * root.zoom;
                alignment: start;

                Text {
                    text: "Video Info";
                    font-size: 22px * root.zoom;
                    font-weight: 700;
                    color: Theme.text-color;
                }

                Rectangle {
                    height: (has-file ? 84px : 170px) * root.zoom;
                    border-radius: 12px;
                    border-width: 2px;
                    border-color: is-drag-hover ? Theme.accent-color : Theme.border-color;
                    background: is-drag-hover ? Theme.hover-background : Theme.panel-background;

                    VerticalBox {
                        alignment: center;
                        spacing: 4px * root.zoom;

                        Text {
                            text: has-file ? file-name : "Drag & drop a file here";
                            color: Theme.text-color;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        Text {
                            visible: !has-file;
                            text: "or use the button below";
                            color: Theme.secondary-text-color;
                            font-size: 13px * root.zoom;
                            horizontal-alignment: center;
                        }
                    }
                }

                Button {
                    text: "Browse for file...";
                    clicked => { root.browse-clicked(); }
                }

                TextInput {
                    visible: status-text != "";
                    text: status-text;
                    color: is-error ? Theme.error-color : Theme.secondary-text-color;
                    font-size: 14px * root.zoom;
                    wrap: word-wrap;
                    read-only: true;
                    single-line: false;
                }

                HorizontalBox {
                    visible: info-rows.length > 0;
                    padding: 0px;
                    alignment: end;

                    Switch {
                        text: "Raw Text View";
                        checked <=> root.show-raw-view;
                    }

                    Button {
                        text: "Copy All";
                        clicked => { root.copy-all-clicked(); }
                    }
                }

                if show-raw-view && info-rows.length > 0: Rectangle {
                    background: Theme.raw-view-background;
                    border-radius: 8px;

                    VerticalBox {
                        padding: 12px * root.zoom;

                        TextInput {
                            text: raw-info-text;
                            font-family: "Courier New";
                            color: Theme.text-color;
                            wrap: word-wrap;
                            read-only: true;
                            single-line: false;
                        }
                    }
                }

                if !show-raw-view: VerticalBox {
                    padding: 0px;
                    spacing: 6px * root.zoom;

                    for row in info-rows: Rectangle {
                        background: Theme.panel-background;
                        border-radius: 6px;

                        HorizontalBox {
                            padding: 6px * root.zoom;
                            spacing: 8px * root.zoom;

                            TextInput {
                                text: row.label;
                                font-weight: 600;
                                color: Theme.accent-color;
                                width: 150px * root.zoom;
                                wrap: word-wrap;
                                read-only: true;
                                single-line: false;
                            }

                            TextInput {
                                text: row.value;
                                color: Theme.text-color;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                                read-only: true;
                                single-line: false;
                            }
                        }
                    }
                }
            }
        }
    }
}

// Icon-only "restore to default" button. Callers control visibility by
// binding it to whether the setting currently differs from its default.
component ResetButton {
    callback clicked();

    width: 20px;
    height: 20px;

    accessible-role: button;
    accessible-label: "Reset to default";
    accessible-action-default => { root.clicked(); }

    TouchArea {
        clicked => { root.clicked(); }

        Text {
            text: "↺";
            font-size: 16px;
            color: parent.has-hover ? Theme.accent-color : Theme.secondary-text-color;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component SettingsWindow inherits Window {
    title: "Settings";
    preferred-width: 340px;
    preferred-height: 220px;
    min-width: 340px;
    min-height: 220px;
    background: Theme.surface-background;
    always-on-top: true;

    in-out property <float> font-size: 16.0;
    // Index into the ComboBox's model below (System/Light/Dark). Bound via
    // current-index rather than current-value: writing current-value
    // doesn't update the ComboBox's visual selection in this Slint version.
    // https://github.com/slint-ui/slint/issues/11970
    in-out property <int> theme-index: 0;
    in-out property <bool> keep-on-top: false;

    // Must match Settings::default() in main.rs.
    property <float> font-size-default: 16.0;
    property <int> theme-index-default: 0;

    callback font-size-changed(float);
    callback theme-changed(string);
    callback keep-on-top-changed(bool);

    VerticalBox {
        padding: 18px;
        spacing: 16px;
        alignment: start;

        Text {
            text: "Settings";
            font-size: 18px;
            font-weight: 700;
            color: Theme.text-color;
        }

        VerticalBox {
            padding: 0px;
            spacing: 4px;

            HorizontalBox {
                padding: 0px;

                Text {
                    text: "Default font size";
                    color: Theme.text-color;
                    horizontal-stretch: 1;
                }

                ResetButton {
                    visible: root.font-size != root.font-size-default;
                    clicked => {
                        root.font-size = root.font-size-default;
                        root.font-size-changed(root.font-size-default);
                    }
                }
            }

            HorizontalBox {
                padding: 0px;
                spacing: 8px;

                Slider {
                    minimum: 12;
                    maximum: 24;
                    step: 1;
                    value <=> root.font-size;
                    changed(v) => { root.font-size-changed(v); }
                }

                Text {
                    text: round(root.font-size) + " px";
                    color: Theme.secondary-text-color;
                    vertical-alignment: center;
                }
            }
        }

        VerticalBox {
            padding: 0px;
            spacing: 4px;

            HorizontalBox {
                padding: 0px;

                Text {
                    text: "Theme";
                    color: Theme.text-color;
                    horizontal-stretch: 1;
                }

                ResetButton {
                    visible: root.theme-index != root.theme-index-default;
                    clicked => {
                        root.theme-index = root.theme-index-default;
                        root.theme-changed("System");
                    }
                }
            }

            ComboBox {
                model: ["System", "Light", "Dark"];
                current-index <=> root.theme-index;
                selected(v) => { root.theme-changed(v); }
            }
        }

        HorizontalBox {
            padding: 0px;

            Text {
                text: "Always on top";
                color: Theme.text-color;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            ResetButton {
                visible: root.keep-on-top;
                clicked => {
                    root.keep-on-top = false;
                    root.keep-on-top-changed(false);
                }
            }

            Switch {
                checked <=> root.keep-on-top;
                toggled => { root.keep-on-top-changed(root.keep-on-top); }
            }
        }
    }
}
